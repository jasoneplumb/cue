{
  "name": "cue-kernel",
  "version": "0.14.0-alpha",
  "description": "Deterministic, allocation-free decision kernel with a bit-exact replay contract \u2014 1 KB of C99, no OS dependencies. Cycling safety cue is the demonstrator.",
  "keywords": [
    "embedded",
    "deterministic",
    "decision-layer",
    "replay",
    "mcu",
    "rp2040",
    "esp32-s2",
    "cortex-m",
    "riscv",
    "c99"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/jasoneplumb/cue"
  },
  "license": "Apache-2.0",
  "frameworks": "*",
  "platforms": "*",
  "headers": "kernel/cue_policy.h",
  "build": {
    "srcDir": "kernel",
    "includeDir": "kernel",
    "srcFilter": [
      "-<*>",
      "+<cue_policy.c>"
    ]
  }
}
