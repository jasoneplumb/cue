<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- HealthKit entitlement: required to start the ride's HKWorkoutSession.
     Automatic signing registers the capability on the app ID; cue never
     reads or writes health data (the usage strings say the same). -->
<dict>
	<key>com.apple.developer.healthkit</key>
	<true/>
</dict>
</plist>
